{
  "name": "create-rat-stack-plus",
  "version": "0.1.0",
  "description": "Scaffold a typed full-stack app on Cloudflare with Alchemy, D1, Turborepo, Oxlint, and a themed shadcn/ui package.",
  "type": "module",
  "license": "MIT",
  "author": "Leo (https://github.com/leoisadev1)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoisadev1/rat-stack-plus.git"
  },
  "homepage": "https://github.com/leoisadev1/rat-stack-plus#readme",
  "bugs": "https://github.com/leoisadev1/rat-stack-plus/issues",
  "keywords": [
    "create-app",
    "scaffold",
    "cloudflare",
    "d1",
    "alchemy",
    "shadcn",
    "better-t-stack",
    "rat-stack",
    "oxlint",
    "turborepo"
  ],
  "bin": {
    "create-rat-stack-plus": "./dist/cli.mjs",
    "rat-stack-plus": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "vendor"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "bun src/cli.ts",
    "check-types": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "check": "bun run check-types && bun run lint && bun run test",
    "check-package": "node scripts/check-package.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "release": "changeset publish"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "create-better-t-stack": "3.44.1",
    "picocolors": "^1.1.1",
    "shadcn": "4.21.0"
  },
  "devDependencies": {
    "@changesets/changelog-git": "^1.0.0",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.2",
    "oxlint": "^1.85.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
